<presentation:VsWindow x:Class="Snek.Graph_Creation.Graph_Input"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:presentation="clr-namespace:Snek.Presentation"
                       mc:Ignorable="d"
                       Title="Daten eingeben – Snek Studio"
                       Icon="/Images/favicon.ico"
                       Width="760" Height="650" MinWidth="620" MinHeight="540"
                       WindowStartupLocation="CenterScreen"
                       KeyDown="Window_KeyDown">
    <Grid Background="{StaticResource VsEditorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <Border Padding="28,22" Background="{StaticResource VsPanelBrush}"
                BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Daten eingeben" Style="{StaticResource VsPageTitle}"/>
                <TextBlock x:Name="GraphTypeText" Margin="0,6,0,0" Style="{StaticResource VsMutedText}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="Werte" Style="{StaticResource VsSectionTitle}" DockPanel.Dock="Left"/>
                <TextBlock x:Name="ValueCountText" Text="0 gültige Werte" Style="{StaticResource VsMutedText}"
                           HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
            <TextBox x:Name="ValuesInput" Grid.Row="1" AcceptsReturn="True" AcceptsTab="False"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono, Consolas" FontSize="15" Padding="12"
                     TextChanged="ValuesInput_TextChanged"
                     ToolTip="Eine Zahl pro Zeile oder mit Semikolon getrennt"/>
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Eine Zahl pro Zeile oder mit Semikolon trennen. Dezimalpunkt und Dezimalkomma werden unterstützt."
                               Style="{StaticResource VsMutedText}"/>
                    <TextBlock x:Name="ValidationMessage" Margin="0,4,0,0" Foreground="{StaticResource VsErrorBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Beispieldaten" Margin="12,0,0,0" Click="SampleButton_Click"/>
                    <Button Content="Leeren" Margin="8,0,0,0" Click="ClearButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="28,14" Background="{StaticResource VsPanelBrush}"
                BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button Content="Zurück" MinWidth="100" Click="BackButton_Click" DockPanel.Dock="Left"/>
                <Button x:Name="CreateButton" Content="Graph erstellen" MinWidth="130" Margin="10,0,0,0"
                        IsEnabled="False" Style="{StaticResource VsPrimaryButton}"
                        Click="CreateButton_Click" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource VsAccentBrush}" Padding="8,2">
            <TextBlock Text="Ctrl+Enter: Erstellen  •  Esc: Zurück" FontSize="11" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</presentation:VsWindow>
