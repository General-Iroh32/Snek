<presentation:VsWindow x:Class="Snek.Graph_Creation.Create_Graph"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:presentation="clr-namespace:Snek.Presentation"
        mc:Ignorable="d"
        Title="Snek Studio"
        Width="1100" Height="700" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Icon="/Images/favicon.ico"
        Background="{StaticResource VsEditorBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Background="{StaticResource VsWindowBrush}"
                BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="/Images/Snek_PNG.png" Width="32" Height="32"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Snek Studio" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Graph workspace" FontSize="11" Foreground="{StaticResource VsMutedTextBrush}"/>
                </StackPanel>
                <Border Grid.Column="3" Background="{StaticResource VsControlBrush}" CornerRadius="2"
                        Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text=".NET 10 · WPF" FontSize="11" Foreground="{StaticResource VsMutedTextBrush}"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource VsPanelBrush}"
                BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,14,0,0">
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource VsMutedTextBrush}" Margin="18,0,0,8"/>
                    <RadioButton Content="Start" Style="{StaticResource VsNavigationItem}"
                                 IsChecked="True" GroupName="MainNavigation"
                                 Command="{Binding HomeViewCommand}"/>
                    <RadioButton Content="POS-Auswertung" Style="{StaticResource VsNavigationItem}"
                                 GroupName="MainNavigation" Command="{Binding PosCommand}"/>
                    <RadioButton Content="Über Snek" Style="{StaticResource VsNavigationItem}"
                                 GroupName="MainNavigation" Command="{Binding UeberUnsCommand}"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource VsCard}" Margin="12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Shortcuts" FontWeight="SemiBold"/>
                        <TextBlock Text="Ctrl+N  Neuer Graph" Style="{StaticResource VsMutedText}" FontSize="11" Margin="0,6,0,0"/>
                        <TextBlock Text="Ctrl+O  Graph öffnen" Style="{StaticResource VsMutedText}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentView}"/>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource VsAccentBrush}">
            <Grid Margin="10,0">
                <TextBlock Text="Bereit" VerticalAlignment="Center" FontSize="11" Foreground="White"/>
                <TextBlock Text="SQLite · Nullable · CI ready" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontSize="11" Foreground="White"/>
            </Grid>
        </Border>
    </Grid>
</presentation:VsWindow>
