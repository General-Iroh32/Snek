<UserControl x:Class="Snek.Graph_Creation.View.UeberUnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="620" d:DesignWidth="880">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="36,30">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Über Snek Studio" Style="{StaticResource VsPageTitle}"/>
                <TextBlock Margin="0,7,0,0" Style="{StaticResource VsMutedText}"
                           Text="Ein Schulprojekt, modernisiert als wartbare .NET-Desktop-Anwendung."/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,26,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource VsCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <Image Source="/Images/Snek_PNG.png" Height="76" HorizontalAlignment="Left" Stretch="Uniform"/>
                        <TextBlock Text="Snek Studio" Margin="0,14,0,0" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource VsMutedText}"
                                   Text="Graphen erstellen und exportieren, POS-Daten lokal auswerten und zwischendurch Snake spielen."/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource VsCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Architektur" Style="{StaticResource VsSectionTitle}"/>
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource VsMutedText}"
                                   Text="Presentation  ·  WPF, MVVM, LiveCharts2&#x0a;Core  ·  Graphlogik, Modelle, Services&#x0a;Infrastructure  ·  EF Core, SQLite, Migrationen&#x0a;Tests  ·  xUnit v3, isolierte Datenbanken"/>
                        <TextBlock Margin="0,18,0,0" Text="Technologie" Style="{StaticResource VsSectionTitle}"/>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource VsMutedText}"
                                   Text=".NET 10 LTS  ·  Nullable  ·  Dependency Injection  ·  Windows CI"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource VsCard}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Ursprüngliches Projektteam" Style="{StaticResource VsSectionTitle}"/>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <TextBlock Text="Dzovani Koller  ·  Projektleitung, Design, Entwicklung" Margin="0,5"/>
                        <TextBlock Text="Karl-Gabriel Jimenez  ·  Dokumentation, Datenbank" Margin="0,5"/>
                        <TextBlock Text="Florian Kozak  ·  Dokumentation, Entwicklung" Margin="0,5"/>
                        <TextBlock Text="Jonas Taferner  ·  Entwicklung, Datenbank" Margin="0,5"/>
                        <TextBlock Text="Oliver Mathe  ·  Entwicklung, Design" Margin="0,5"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
