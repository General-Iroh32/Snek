<UserControl x:Class="Snek.Graph_Creation.View.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="620" d:DesignWidth="880">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="POS-Auswertung" Style="{StaticResource VsPageTitle}"/>
            <TextBlock Margin="0,6,0,0" Style="{StaticResource VsMutedText}"
                       Text="Mitwirkende auswählen, Arbeit öffnen und erfasste Zeiten nachvollziehen."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource VsCard}" Padding="0" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <Border Padding="14,11" Background="{StaticResource VsControlBrush}">
                        <TextBlock Text="1  Mitwirkende" FontWeight="SemiBold"/>
                    </Border>
                    <ListBox x:Name="lstMitwirkende" Grid.Row="1" BorderThickness="0"
                             ItemsSource="{Binding AllMitwirkende}" SelectionChanged="MitwirkendeSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding VollerName}"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="Keine Mitwirkenden vorhanden"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource VsMutedText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=lstMitwirkende}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource VsCard}" Padding="0" Margin="7,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <Border Padding="14,11" Background="{StaticResource VsControlBrush}">
                        <TextBlock Text="2  Arbeiten" FontWeight="SemiBold"/>
                    </Border>
                    <ListBox x:Name="lstArbeiten" Grid.Row="1" BorderThickness="0"
                             ItemsSource="{Binding ArbeitenByMitwirkende}" SelectionChanged="ArbeitenSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Art}"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="Mitwirkende auswählen"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource VsMutedText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=lstArbeiten}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource VsCard}" Padding="0" Margin="7,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <Border Padding="14,11" Background="{StaticResource VsControlBrush}">
                        <TextBlock Text="3  Zeiteinträge" FontWeight="SemiBold"/>
                    </Border>
                    <ListBox x:Name="lstZeiten" Grid.Row="1" BorderThickness="0" ItemsSource="{Binding ZeitenByArbeiten}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Stunden}"/><Run Text=" h  "/><Run Text="{Binding Minuten}"/><Run Text=" min  "/><Run Text="{Binding Sekunden}"/><Run Text=" s"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="Arbeit auswählen"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource VsMutedText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=lstZeiten}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.ColumnSpan="3" Background="#B2181818"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4"/>
                    <TextBlock Text="Daten werden geladen …" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource VsCard}" Padding="16,12">
            <Grid>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource VsErrorBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Gesamtzeit" Style="{StaticResource VsMutedText}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Gesamtzeit}" Margin="14,0,0,0" FontFamily="Cascadia Mono, Consolas"
                               FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource VsAccentHoverBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
