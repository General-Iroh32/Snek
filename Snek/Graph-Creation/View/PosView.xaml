<UserControl x:Class="Snek.Graph_Creation.View.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Snek.Graph_Creation.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="200*"/>
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="lstMitwirkende" Grid.Column="0" Grid.Row="0" ItemsSource="{Binding AllMitwirkende}" SelectionChanged="MitwirkendeSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <TextBlock Margin="5,0,0,0" Text="{Binding Path=Vorname}" FontSize="12"></TextBlock>
                            <TextBlock Margin="5,0,0,0" Text="{Binding Path=Nachname}" FontSize="12"></TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListBox x:Name="lstArbeiten" Grid.Column="1" ItemsSource="{Binding ArbeitenByMitwirkende}" SelectionChanged="ArbeitenSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <TextBlock Margin="5,0,0,0" Text="{Binding Path=Art}" FontSize="12"></TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListBox x:Name="lstZeiten" Grid.Column="2" ItemsSource="{Binding ZeitenByArbeiten}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <TextBlock Margin="5,0,0,0" Text="{Binding Path=Stunden}" FontSize="12"></TextBlock>
                            <TextBlock Margin="5,0,0,0" Text="{Binding Path=Minuten}" FontSize="12"></TextBlock>
                            <TextBlock Margin="5,0,0,0" Text="{Binding Path=Sekunden}" FontSize="12"></TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" Text="{Binding Gesamtzeit}" FontSize="20"
            Foreground="LightGray"/>

        <TextBlock Grid.ColumnSpan="3" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Text="{Binding ErrorMessage}" Foreground="#ec4646" Margin="8,0"/>

    </Grid>
</UserControl>
