<presentation:VsWindow x:Class="Snek.Graph_Creation.Graph_Creator"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
                       xmlns:presentation="clr-namespace:Snek.Presentation"
                       mc:Ignorable="d"
                       Title="Graph – Snek Studio"
                       Icon="/Images/favicon.ico"
                       Width="1120" Height="720" MinWidth="860" MinHeight="560"
                       WindowStartupLocation="CenterScreen"
                       KeyDown="Window_KeyDown">
    <Grid Background="{StaticResource VsEditorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <Border Padding="26,18" Background="{StaticResource VsPanelBrush}"
                BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="GraphTitleText" Style="{StaticResource VsPageTitle}"/>
                    <TextBlock x:Name="GraphSummaryText" Margin="0,5,0,0" Style="{StaticResource VsMutedText}"/>
                </StackPanel>
                <Image Source="/Images/Snek_PNG.png" Width="72" Height="40"
                       Stretch="Uniform" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource VsCard}" Padding="12" Margin="0,0,16,0">
                <Grid Background="{StaticResource VsEditorBrush}">
                    <lvc:CartesianChart x:Name="Chart1" Visibility="Collapsed"/>
                    <lvc:PieChart x:Name="Chart2" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource VsCard}">
                    <StackPanel>
                        <TextBlock Text="Graph-Aktionen" Style="{StaticResource VsSectionTitle}"/>
                        <TextBlock Margin="0,5,0,16" Style="{StaticResource VsMutedText}"
                                   Text="Speichere das Projekt oder exportiere die aktuelle Ansicht."/>
                        <Button Content="Snek-Datei speichern" Style="{StaticResource VsPrimaryButton}"
                                Click="SaveButton_Click"/>
                        <Button Content="Als PNG exportieren" Margin="0,8,0,0" Click="ExportButton_Click"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource VsCard}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Weiterarbeiten" Style="{StaticResource VsSectionTitle}"/>
                        <Button Content="Werte bearbeiten" Margin="0,14,0,0" Click="EditButton_Click"/>
                        <Button Content="Neuer Graph" Margin="0,8,0,0" Click="NewButton_Click"/>
                        <Button Content="Zur Startseite" Margin="0,8,0,0" Click="HomeButton_Click"/>
                    </StackPanel>
                </Border>
                <TextBlock Margin="2,14,0,0" Style="{StaticResource VsMutedText}"
                           Text="Ctrl+S  Speichern&#x0a;Ctrl+Shift+S  PNG exportieren&#x0a;Esc  Startseite"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource VsAccentBrush}" Padding="8,2">
            <TextBlock x:Name="StatusText" Text="Bereit" FontSize="11" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</presentation:VsWindow>
