<presentation:VsWindow x:Class="Snek.Graph_Creation.Window1"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:presentation="clr-namespace:Snek.Presentation"
                       mc:Ignorable="d"
                       Title="Snake – Snek Studio" Icon="/Images/favicon.ico"
                       Width="700" Height="520" ResizeMode="NoResize"
                       WindowStartupLocation="CenterOwner"
                       KeyDown="Window_KeyDown">
    <Grid Background="{StaticResource VsEditorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <Border Padding="20,14" Background="{StaticResource VsPanelBrush}"
                BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Snake" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="GameStateText" Text="Läuft" Margin="14,4,0,0"
                               Foreground="{StaticResource VsSuccessBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Score" Style="{StaticResource VsMutedText}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ScoreText" Text="0" Margin="10,0,0,0" FontSize="20"
                               FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Border Background="#101010" BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="1">
                <Grid Width="620" Height="380">
                    <Canvas x:Name="GameCanvas" Width="620" Height="380" Background="#101010"/>
                    <Border x:Name="Overlay" Background="#C0181818" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="OverlayTitle" Text="Pausiert" FontSize="30" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="OverlayHint" Text="Leertaste zum Fortsetzen" Margin="0,10,0,0"
                                       Style="{StaticResource VsMutedText}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource VsAccentBrush}" Padding="8,2">
            <TextBlock Text="Pfeiltasten / WASD: Steuern  •  Leertaste: Pause  •  R: Neustart  •  Esc: Schließen"
                       FontSize="11" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</presentation:VsWindow>
