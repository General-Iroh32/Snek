<presentation:VsWindow x:Class="Snek.Graph_Creation.Create_Graph_Type"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:presentation="clr-namespace:Snek.Presentation"
                       mc:Ignorable="d"
                       Title="Graphentyp auswählen – Snek Studio"
                       Icon="/Images/favicon.ico"
                       Width="880" Height="610" MinWidth="720" MinHeight="520"
                       WindowStartupLocation="CenterScreen"
                       KeyDown="Window_KeyDown">
    <Grid Background="{StaticResource VsEditorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <Border Padding="28,22" Background="{StaticResource VsPanelBrush}"
                BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Neuen Graph erstellen" Style="{StaticResource VsPageTitle}"/>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource VsMutedText}"
                           Text="Wähle eine Visualisierung. Ein Doppelklick öffnet direkt die Dateneingabe."/>
            </StackPanel>
        </Border>

        <ListBox x:Name="GraphTypeList" Grid.Row="1" Margin="28,24"
                 Background="Transparent" BorderThickness="0"
                 SelectionChanged="GraphTypeList_SelectionChanged"
                 MouseDoubleClick="GraphTypeList_MouseDoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBoxItem Tag="Line Series" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="╱  Liniendiagramm" Style="{StaticResource VsSectionTitle}"/>
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource VsMutedText}" Text="Trends und zeitliche Verläufe"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Vertical Line Series" Margin="10,0,0,10">
                <StackPanel>
                    <TextBlock Text="│  Vertikale Linie" Style="{StaticResource VsSectionTitle}"/>
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource VsMutedText}" Text="Vertikal ausgerichtete Datenreihe"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Column Series" Margin="0,10,10,10">
                <StackPanel>
                    <TextBlock Text="▥  Säulendiagramm" Style="{StaticResource VsSectionTitle}"/>
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource VsMutedText}" Text="Werte übersichtlich vergleichen"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Row Series" Margin="10,10,0,10">
                <StackPanel>
                    <TextBlock Text="▰  Balkendiagramm" Style="{StaticResource VsSectionTitle}"/>
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource VsMutedText}" Text="Horizontaler Kategorienvergleich"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Pie Chart" Margin="0,10,10,0">
                <StackPanel>
                    <TextBlock Text="◕  Kreisdiagramm" Style="{StaticResource VsSectionTitle}"/>
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource VsMutedText}" Text="Anteile eines Ganzen darstellen"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Doughnut" Margin="10,10,0,0">
                <StackPanel>
                    <TextBlock Text="◉  Ringdiagramm" Style="{StaticResource VsSectionTitle}"/>
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource VsMutedText}" Text="Kompakte Darstellung von Anteilen"/>
                </StackPanel>
            </ListBoxItem>
        </ListBox>

        <Border Grid.Row="2" Padding="28,14" Background="{StaticResource VsPanelBrush}"
                BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button Content="Zurück" MinWidth="100" Click="BackButton_Click" DockPanel.Dock="Left"/>
                <Button x:Name="ContinueButton" Content="Weiter" MinWidth="100" Margin="10,0,0,0"
                        IsEnabled="False" Style="{StaticResource VsPrimaryButton}"
                        Click="ContinueButton_Click" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource VsAccentBrush}" Padding="8,2">
            <TextBlock Text="Bereit  •  Enter: Weiter  •  Esc: Zurück" FontSize="11" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</presentation:VsWindow>
